{
  "openapi": "3.1.0",
  "info": { "title": "Apistra CAP-02 governed tools", "version": "0.1.0" },
  "paths": {
    "/api/v1/projects/{project_id}/tools": { "get": {}, "post": {} },
    "/api/v1/projects/{project_id}/tools/{tool_id}/versions": { "get": {}, "post": {} },
    "/api/v1/projects/{project_id}/tools/{tool_id}/versions/{tool_version}:evaluate": { "post": {} }
  },
  "components": {
    "schemas": {
      "ToolVersionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input_schema", "output_schema", "effect_class", "actions"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "description": { "type": "string", "maxLength": 4096, "default": "" },
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" },
          "effect_class": { "type": "string", "enum": ["READ", "WRITE", "ADMINISTRATIVE"] },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      },
      "ToolEvaluationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "scope"],
        "properties": {
          "action": { "type": "string", "minLength": 1, "maxLength": 128 },
          "scope": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
