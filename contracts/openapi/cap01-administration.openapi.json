{
  "openapi": "3.1.0",
  "info": {
    "title": "Apistra CAP-01 Administration API",
    "version": "1.0.0",
    "description": "Versioned local identity and isolated project lifecycle contract."
  },
  "paths": {
    "/api/v1/installation": { "get": {} },
    "/api/v1/administrators:bootstrap": { "post": {} },
    "/api/v1/sessions": { "post": {} },
    "/api/v1/session": { "get": {}, "delete": {} },
    "/api/v1/audit-events": { "get": {} },
    "/api/v1/projects": { "get": {}, "post": {} },
    "/api/v1/projects/{project_id}": { "get": {}, "patch": {} },
    "/api/v1/projects/{project_id}:archive": { "post": {} }
  },
  "components": {
    "schemas": {
      "ProjectRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "key"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "key": { "type": "string", "minLength": 2, "maxLength": 32 }
        }
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "key", "status", "version", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "key": { "type": "string" },
          "status": { "enum": ["ACTIVE", "ARCHIVED"] },
          "version": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "AuditEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_type",
          "created_at",
          "correlation_id",
          "actor",
          "subject_id",
          "project_id",
          "project_key"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "event_type": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "correlation_id": { "type": "string" },
          "actor": { "type": ["string", "null"] },
          "subject_id": { "type": ["string", "null"], "format": "uuid" },
          "project_id": { "type": ["string", "null"], "format": "uuid" },
          "project_key": { "type": ["string", "null"] }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "detail", "correlation_id"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "correlation_id": { "type": "string" }
        }
      }
    }
  }
}
