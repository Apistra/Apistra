{
  "openapi": "3.1.0",
  "info": { "title": "Apistra CAP-02 secret references", "version": "0.1.0" },
  "paths": {
    "/api/v1/projects/{project_id}/secrets": { "get": {}, "post": {} },
    "/api/v1/projects/{project_id}/secrets/{reference_id}": { "put": {}, "delete": {} }
  },
  "components": {
    "schemas": {
      "SecretCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 64 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": { "type": "string", "minLength": 1, "maxLength": 65536, "writeOnly": true }
        }
      },
      "SecretReference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project_id", "name", "purpose", "status", "version", "envelope_version", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "project_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "REVOKED"] },
          "version": { "type": "integer", "minimum": 1 },
          "envelope_version": { "type": "integer", "const": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
