{
  "version": 1,
  "flow": ["feature/*", "test", "staging", "main"],
  "branches": {
    "test": {
      "pull_requests_required": true,
      "pull_request_reviews": 0,
      "dismiss_stale_reviews": false,
      "require_code_owner_reviews": false,
      "require_conversation_resolution": true,
      "strict_status_checks": true,
      "enforce_admins": true,
      "required_linear_history": true,
      "allow_force_pushes": false,
      "allow_deletions": false,
      "required_checks": ["Contract and static checks", "Architecture", "Tests", "Security and supply chain", "Package candidate"]
    },
    "staging": {
      "pull_requests_required": true,
      "pull_request_reviews": 0,
      "dismiss_stale_reviews": false,
      "require_code_owner_reviews": false,
      "require_conversation_resolution": true,
      "strict_status_checks": true,
      "enforce_admins": true,
      "required_linear_history": true,
      "allow_force_pushes": false,
      "allow_deletions": false,
      "required_checks": ["Contract and static checks", "Architecture", "Tests", "Security and supply chain", "Package candidate"]
    },
    "main": {
      "pull_requests_required": true,
      "pull_request_reviews": 0,
      "dismiss_stale_reviews": false,
      "require_code_owner_reviews": false,
      "require_conversation_resolution": true,
      "strict_status_checks": true,
      "enforce_admins": true,
      "required_linear_history": true,
      "allow_force_pushes": false,
      "allow_deletions": false,
      "required_checks": ["Contract and static checks", "Architecture", "Tests", "Security and supply chain", "Package candidate"]
    }
  },
  "deployment": { "automatic": false }
}
