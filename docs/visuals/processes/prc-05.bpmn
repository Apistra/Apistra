      <bpmn:outgoing>Flow_PRC-05_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="PRC-05_decision" name="Decision?">
      <bpmn:incoming>Flow_PRC-05_03</bpmn:incoming>
      <bpmn:outgoing>Flow_PRC-05_04</bpmn:outgoing>
