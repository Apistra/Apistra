      <bpmn:outgoing>Flow_PRC-05_09</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_PRC-05_timeout">
        <bpmn:timeDuration>PT0S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="PRC-05_approved" name="Run resumed">
      <bpmn:incoming>Flow_PRC-05_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="PRC-05_rejected" name="Path rejected">
      <bpmn:incoming>Flow_PRC-05_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="PRC-05_timedout" name="Timed out safely">
      <bpmn:incoming>Flow_PRC-05_09</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
