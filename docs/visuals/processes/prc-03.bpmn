        <di:waypoint x="525" y="320.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_PRC-03_04" bpmnElement="Flow_PRC-03_04">
        <di:waypoint x="615" y="320.0" />
        <di:waypoint x="675" y="470.0" />
      </bpmndi:BPMNEdge>
