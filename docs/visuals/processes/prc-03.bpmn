      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PRC-03_acceptable" bpmnElement="PRC-03_acceptable">
        <dc:Bounds x="840.0" y="140.0" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PRC-03_publish" bpmnElement="PRC-03_publish">
        <dc:Bounds x="962.0" y="434.0" width="116" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PRC-03_done" bpmnElement="PRC-03_done">
        <dc:Bounds x="1140.0" y="140.0" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PRC-03_rejected" bpmnElement="PRC-03_rejected">
        <dc:Bounds x="1290.0" y="290.0" width="60" height="60" />
      </bpmndi:BPMNShape>
