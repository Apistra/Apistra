<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PRC-06" targetNamespace="https://apistra.dev/bpmn" exporter="Apistra BuildBySpec visual generator" exporterVersion="0.1">
  <bpmn:process id="PRC-06" name="Evaluate workflow quality" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PRC-06">
      <bpmn:lane id="Lane_PRC-06_1" name="AI engineer">
        <bpmn:flowNodeRef>PRC-06_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-06_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PRC-06_2" name="Evaluation service">
        <bpmn:flowNodeRef>PRC-06_run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-06_metrics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-06_record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PRC-06_3" name="Policy and review">
        <bpmn:flowNodeRef>PRC-06_calibrated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-06_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-06_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_PRC-06_01" sourceRef="PRC-06_start" targetRef="PRC-06_run" />
    <bpmn:sequenceFlow id="Flow_PRC-06_02" sourceRef="PRC-06_run" targetRef="PRC-06_metrics" />
    <bpmn:sequenceFlow id="Flow_PRC-06_03" sourceRef="PRC-06_metrics" targetRef="PRC-06_calibrated" />
    <bpmn:sequenceFlow id="Flow_PRC-06_04" sourceRef="PRC-06_calibrated" targetRef="PRC-06_apply" name="yes" />
    <bpmn:sequenceFlow id="Flow_PRC-06_05" sourceRef="PRC-06_calibrated" targetRef="PRC-06_review" name="no" />
    <bpmn:sequenceFlow id="Flow_PRC-06_06" sourceRef="PRC-06_apply" targetRef="PRC-06_record" />
    <bpmn:sequenceFlow id="Flow_PRC-06_07" sourceRef="PRC-06_review" targetRef="PRC-06_record" />
    <bpmn:sequenceFlow id="Flow_PRC-06_08" sourceRef="PRC-06_record" targetRef="PRC-06_done" />
    <bpmn:startEvent id="PRC-06_start" name="Select dataset and candidates">
      <bpmn:outgoing>Flow_PRC-06_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="PRC-06_run" name="Execute versioned evaluation">
      <bpmn:incoming>Flow_PRC-06_01</bpmn:incoming>
      <bpmn:outgoing>Flow_PRC-06_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="PRC-06_metrics" name="Calculate quality, cost and latency">
      <bpmn:incoming>Flow_PRC-06_02</bpmn:incoming>
      <bpmn:outgoing>Flow_PRC-06_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="PRC-06_calibrated" name="Policy calibrated?">
      <bpmn:incoming>Flow_PRC-06_03</bpmn:incoming>
      <bpmn:outgoing>Flow_PRC-06_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_PRC-06_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="PRC-06_apply" name="Apply configured gate">
      <bpmn:incoming>Flow_PRC-06_04</bpmn:incoming>
      <bpmn:outgoing>Flow_PRC-06_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="PRC-06_review" name="Request human review">
      <bpmn:incoming>Flow_PRC-06_05</bpmn:incoming>
      <bpmn:outgoing>Flow_PRC-06_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="PRC-06_record" name="Record comparison evidence">
      <bpmn:incoming>Flow_PRC-06_06</bpmn:incoming>
      <bpmn:incoming>Flow_PRC-06_07</bpmn:incoming>
      <bpmn:outgoing>Flow_PRC-06_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="PRC-06_done" name="Evaluation complete">
      <bpmn:incoming>Flow_PRC-06_08</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
